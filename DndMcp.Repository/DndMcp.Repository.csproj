<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DndMcp.Repository</RootNamespace>
    <AssemblyName>DndMcp.Repository</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DndMcp.Domain\DndMcp.Domain.csproj" />
  </ItemGroup>

  <!-- Microsoft.Data.Sqlite's default bundle (SQLitePCLRaw e_sqlite3) ships FTS5 and JSON1, which the
       campaign schema and the SRD index both depend on. SqliteCapabilityTests pins that, so a bundle
       swap that drops either fails a test instead of failing at first query. -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- ILogger only (no logging implementation): CampaignDatabase reports failed daily backups, a journal mode that is not
       WAL and backup-retention failures as warnings, because none of them may block a write. The host already uses
       10.0.12 through Microsoft.Extensions.Hosting, so this adds no second version. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- campaigns.db's schema ships inside the assembly as NNNN_name.sql resources, so the migrator can never run against a
       migration set that differs from the code that reads the tables (loose files next to a single-file publish can be
       stale or missing). The logical name is fixed, not derived from the folder, so a file move cannot silently drop a
       migration from the set CampaignDbMigrator discovers. -->
  <ItemGroup>
    <EmbeddedResource Include="Campaign\Migrations\*.sql" LogicalName="DndMcp.Repository.Campaign.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The index builder's pairing and aliasing internals (SrdCounterparts.Match, IndexedDocument) are pinned directly
       by unit tests, the same arrangement as Domain's numerical internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DndMcp.Tests" />
  </ItemGroup>

</Project>
