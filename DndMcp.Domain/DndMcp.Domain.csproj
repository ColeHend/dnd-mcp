<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DndMcp.Domain</RootNamespace>
    <AssemblyName>DndMcp.Domain</AssemblyName>
  </PropertyGroup>

  <!-- Deliberately ZERO ProjectReferences and no MCP dependency. Dice, probability, DPR, simulation and
